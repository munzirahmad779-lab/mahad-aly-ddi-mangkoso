{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mahad-aly-ddi-mangkoso",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "0 0 */3 * *"
    ]
  }
}
